-- スピード維持用変数
local targetWalkSpeed = nil
local targetJumpPower = nil

local function CreateSpeedControl(name, defaultVal, maxVal, callback)
	local container = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 45),
		BackgroundColor3 = Theme.CardBg,
		Parent = Content,
	})
	AddCorner(container, 6)
	AddStroke(container, Theme.Stroke, 1)
	
	Create("TextLabel", {
		Text = name,
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.new(0, 15, 0, 0),
		Size = UDim2.new(0.4, 0, 1, 0),
		BackgroundTransparency = 1,
		Parent = container,
	})
	
	local valLabel = Create("TextLabel", {
		Text = tostring(defaultVal),
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.new(0.4, 0, 0, 0),
		Size = UDim2.new(0.2, 0, 1, 0),
		BackgroundTransparency = 1,
		Parent = container,
	})
	
	local minusBtn = Create("TextButton", {
		Text = "-", Font = Enum.Font.GothamBold, TextSize = 18,
		TextColor3 = Theme.Text, BackgroundColor3 = Theme.Bg,
		Position = UDim2.new(0.65, 0, 0.1, 0), Size = UDim2.new(0.15, 0, 0.8, 0),
		AutoButtonColor = false, Parent = container,
	})
	AddCorner(minusBtn, 4)
	
	local plusBtn = Create("TextButton", {
		Text = "+", Font = Enum.Font.GothamBold, TextSize = 18,
		TextColor3 = Theme.Text, BackgroundColor3 = Theme.Bg,
		Position = UDim2.new(0.82, 0, 0.1, 0), Size = UDim2.new(0.15, 0, 0.8, 0),
		AutoButtonColor = false, Parent = container,
	})
	AddCorner(plusBtn, 4)
	
	local currentVal = defaultVal
	local function updateVal(amount)
		currentVal = math.clamp(currentVal + amount, 16, maxVal)
		valLabel.Text = tostring(currentVal)
		callback(currentVal)
	end
	
	minusBtn.MouseButton1Click:Connect(function() updateVal(-10) end)
	plusBtn.MouseButton1Click:Connect(function() updateVal(10) end)
end

CreateSpeedControl("WalkSpeed", 16, 200, function(val)
	targetWalkSpeed = val
	if val <= 16 then targetWalkSpeed = nil end -- 16以下なら通常に戻す
end)

CreateSpeedControl("JumpPower", 50, 300, function(val)
	targetJumpPower = val
	if val <= 50 then targetJumpPower = nil end
end)

