-- ロジック
-- ==========================================

-- 1. AntiCheatの無効化
DisableBtn.MouseButton1Click:Connect(function()
	local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
	if playerScripts then
		local antiCheat = playerScripts:FindFirstChild("AntiCheat")
		if antiCheat then
			local success, err = pcall(function()
				antiCheat.Disabled = true
				antiCheat.Name = "AntiCheat_Disabled_" .. math.random(1, 1000)
			end)
			if success then
				StatusLabel.Text = "Status: Local AntiCheat Disabled!"
				StatusLabel.TextColor3 = Theme.Green
				DisableBtn.Text = "AntiCheat Disabled"
				DisableBtn.BackgroundColor3 = Theme.Stroke
			else
				StatusLabel.Text = "Status: Failed to disable AC."
				StatusLabel.TextColor3 = Theme.Red
			end
		else
			StatusLabel.Text = "Status: AntiCheat script not found."
			StatusLabel.TextColor3 = Theme.Red
		end
	end
end)

-- 2. Quarantine Bypass (Cmdr) 
CmdrBtn.MouseButton1Click:Connect(function()
	local cmdrClient = ReplicatedStorage:FindFirstChild("CmdrClient")
	if not cmdrClient then return end
	local cmdrFunc = cmdrClient:FindFirstChild("CmdrFunction")
	if not cmdrFunc then return end
	
	CmdrBtn.Text = "Sending..."
	
	task.spawn(function()
		local success, err = pcall(function()
			cmdrFunc:InvokeServer("unquarantine", LocalPlayer.Name)
		end)
		
		if success then
			StatusLabel.Text = "Status: Sent Unquarantine request."
			StatusLabel.TextColor3 = Theme.Green
			CmdrBtn.Text = "Request Sent"
		else
			StatusLabel.Text = "Status: Cmdr failed (No perms)."
			StatusLabel.TextColor3 = Theme.Red
			CmdrBtn.Text = "Bypass Quarantine (Cmdr)"
		end
		
		task.wait(2)
		CmdrBtn.Text = "Bypass Quarantine (Cmdr)"
	end)
end)

-- 3. スピード強制維持ループ (AntiCheatのリセットを上書き)
RunService.Heartbeat:Connect(function()
	local char = LocalPlayer.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	
	if targetWalkSpeed and hum.WalkSpeed ~= targetWalkSpeed then
		hum.WalkSpeed = targetWalkSpeed
	end
	
	if targetJumpPower and hum.JumpPower ~= targetJumpPower then
		hum.JumpPower = targetJumpPower
		hum.UseJumpPower = true
	end
end)

-- キャラクター再スポーン時にターゲット値を再適用
LocalPlayer.CharacterAdded:Connect(function(char)
	task.wait(1)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		if targetWalkSpeed then hum.WalkSpeed = targetWalkSpeed end
		if targetJumpPower then hum.JumpPower = targetJumpPower; hum.UseJumpPower = true end
	end
end)

-- ==========================================
-- ドラッグ移動
-- ==========================================
local dragging = false
local dragStart, startPos
local currentDragTarget = nil

local function startDrag(input, target)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = target.Position
		currentDragTarget = target
	end
end

TopBar.InputBegan:Connect(function(input) startDrag(input, MainFrame) end)
RestoreBtn.InputBegan:Connect(function(input) startDrag(input, RestoreBtn) end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and currentDragTarget and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		local newX = startPos.X.Offset + delta.X
		local newY = startPos.Y.Offset + delta.Y
		
		local viewport = Camera.ViewportSize
		local frameWidth = currentDragTarget.AbsoluteSize.X
		local frameHeight = currentDragTarget.AbsoluteSize.Y
		
		newX = math.clamp(newX, -frameWidth/2 + 50, viewport.X - 50)
		newY = math.clamp(newY, 0, viewport.Y - 50)
		
		currentDragTarget.Position = UDim2.new(startPos.X.Scale, newX, startPos.Y.Scale, newY)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
		currentDragTarget = nil
	end
end)
